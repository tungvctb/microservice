{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=product_db;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Jwt": {
    "Issuer": "ecommerce-identity",
    "Audience": "ecommerce-api",
    "SecretKey": "dev-only-super-secret-key-please-change-in-production-32b+",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultTtlMinutes": 10
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "AutoCreateTopics": true,
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1
  },
  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxRetryCount": 5
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "SeedData": true,
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
