{
  "Jwt": {
    "Issuer": "ecommerce-identity",
    "Audience": "ecommerce-api",
    "SecretKey": "dev-only-super-secret-key-please-change-in-production-32b+"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "HealthTargets": {
    "identity": "http://localhost:5100",
    "product": "http://localhost:5101",
    "inventory": "http://localhost:5102",
    "order": "http://localhost:5103",
    "payment": "http://localhost:5104",
    "notification": "http://localhost:5105"
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "products": {
        "ClusterId": "product",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "categories": {
        "ClusterId": "product",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "stocks": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/stocks/{**catch-all}" }
      },
      "reservations": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/reservations/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "order",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "payment",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "signalr-hub": {
        "ClusterId": "notification",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:5100" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Path": "/health/live" }
        }
      },
      "product": {
        "Destinations": { "d1": { "Address": "http://localhost:5101" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Path": "/health/live" }
        }
      },
      "inventory": {
        "Destinations": { "d1": { "Address": "http://localhost:5102" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Path": "/health/live" }
        }
      },
      "order": {
        "Destinations": { "d1": { "Address": "http://localhost:5103" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Path": "/health/live" }
        }
      },
      "payment": {
        "Destinations": { "d1": { "Address": "http://localhost:5104" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Path": "/health/live" }
        }
      },
      "notification": {
        "Destinations": { "d1": { "Address": "http://localhost:5105" } },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:15", "Timeout": "00:00:03", "Path": "/health/live" }
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
